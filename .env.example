# Copie para .env e preencha. Nunca versione o .env.
# Segredos: use `openssl rand -hex 32` (só letras e números, por causa das URLs de banco).

# --- Dono do bot: só este número é atendido (formato 55 + DDD + número, sem símbolos)
OWNER_PHONE=55

# --- Evolution API (WhatsApp)
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=troque-por-uma-chave-longa
EVOLUTION_INSTANCE=assistente
# Header X-Webhook-Secret que a Evolution envia ao app
WEBHOOK_SECRET=troque-por-outro-segredo-longo
# Para onde a Evolution manda o webhook (rede interna do Docker)
APP_WEBHOOK_URL=http://app:8000/webhook/evolution
# Provisório: bot no próprio número do dono, conversa consigo mesmo (ver SPEC.md). Com o chip: false
SELF_CHAT_MODE=false

# --- Banco
POSTGRES_USER=app
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=assistente
DATABASE_URL=postgresql+psycopg://app:troque-esta-senha@postgres:5432/assistente
# Banco dos testes (serviço postgres-test do compose); o nome precisa terminar em _test
TEST_DATABASE_URL=postgresql+psycopg://test:test@localhost:5433/assistente_test

# --- Modelos (Vercel AI Gateway, API compatível com OpenAI)
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# Preencher depois da prova da fase 2 (formato fornecedor/modelo, como no catálogo do gateway)
MODEL_CLASSIFIER=
MODEL_PRIMARY=
MODEL_ESCALATION=
# Fornecedores permitidos para o filtro "only", separados por vírgula
ALLOWED_PROVIDERS=

# --- Transcrição de áudio (fase 4): faster-whisper | openai
TRANSCRIBE_BACKEND=faster-whisper
# Modelo do faster-whisper: small (padrão) ou medium (melhor e mais lento)
WHISPER_MODEL=small

# --- Google Calendar (fase 3)
# Preenchido por: uv run python -m app.integrations.gcal_setup CHAVE.json SEU_EMAIL@gmail.com
# JSON da service account em base64 (o Docker Desktop não monta arquivos da pasta do projeto).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternativa, se o arquivo estiver acessível ao contêiner:
GOOGLE_SERVICE_ACCOUNT_FILE=
# Calendário principal = o seu e-mail do Google
GOOGLE_CALENDAR_ID=

# --- Geral
TZ=America/Sao_Paulo
LOG_LEVEL=INFO

# --- Fase 6: alertas, dead man's switch e backup
# Canal de alerta fora do WhatsApp (ntfy): https://ntfy.sh/<tópico-secreto-longo>
ALERT_NTFY_URL=
ALERT_NTFY_TOKEN=
# Ping periódico do app (ex.: https://hc-ping.com/<uuid> do healthchecks.io)
HEALTHCHECK_URL=
# Ping do backup diário (outro check no healthchecks.io)
HEALTHCHECK_BACKUP_URL=
# Destino do backup no rclone (ex.: r2:life-manager-backup); a chave pública fica em deploy/backup.pub
BACKUP_DEST=
BACKUP_KEEP_DAYS=30

# --- Fase 7: MCP em /mcp (vazio = desligado). Gere com: openssl rand -hex 32
MCP_TOKEN=
# Hosts aceitos; no VPS acrescente o nome/IP do Tailscale (ex.: jarvis.tailnet.ts.net:*)
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
